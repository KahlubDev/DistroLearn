# Copy to .env and fill in. .env is already in .gitignore and must never be committed.
#
#   cp .env.example .env
#
# The placeholders below are development-only values. Replace them with anything you like
# locally; the important part is that the real values stay out of git.

# Postgres owner role. Migrations run as this user.
POSTGRES_USER=distrolearn
POSTGRES_PASSWORD=change-me-owner
POSTGRES_DB=distrolearn

# Application role. RLS applies to this role and it has NOBYPASSRLS, which is what makes the
# tenant isolation test meaningful. It never owns a table.
POSTGRES_APP_USER=app
POSTGRES_APP_PASSWORD=change-me-app

# Stamped into the service binaries and logged at startup, so a running container reports
# which commit it is.
VERSION=dev